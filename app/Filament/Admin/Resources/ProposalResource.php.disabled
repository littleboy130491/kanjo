<?php

namespace App\Filament\Admin\Resources;

use App\Filament\Admin\Resources\ProposalResource\Pages;
use App\Models\Proposal;
use Filament\Forms;
use Filament\Forms\Form;
use Filament\Resources\Resource;
use Filament\Tables;
use Filament\Tables\Table;
use SolutionForest\FilamentTranslateField\Forms\Component\Translate;

class ProposalResource extends Resource
{
    protected static ?string $model = Proposal::class;

    protected static ?string $navigationIcon = 'heroicon-o-document-text';

    protected static ?int $navigationSort = 1;

    public static function form(Form $form): Form
    {
        return $form
            ->schema([
                Forms\Components\Tabs::make('Proposal')
                    ->tabs([
                        Forms\Components\Tabs\Tab::make('Document Info')
                            ->schema([
                                Forms\Components\Section::make('Document Numbering')
                                    ->schema([
                                        Forms\Components\TextInput::make('document_number')
                                            ->disabled()
                                            ->dehydrated(false)
                                            ->visible(fn (?Proposal $record): bool => $record !== null),
                                        Forms\Components\TextInput::make('document_number_suffix')
                                            ->default('NEW')
                                            ->maxLength(255)
                                            ->disabled(fn (Forms\Get $get): bool => ! $get('document_number_override')),
                                        Forms\Components\Toggle::make('document_number_override')
                                            ->live()
                                            ->default(false),
                                    ])
                                    ->columns(3),

                                Forms\Components\Section::make('Document Settings')
                                    ->schema([
                                        Forms\Components\Select::make('company_id')
                                            ->relationship('company', 'brand_name')
                                            ->required()
                                            ->searchable()
                                            ->preload(),
                                        Forms\Components\Select::make('status')
                                            ->options([
                                                'draft' => 'Draft',
                                                'published' => 'Published',
                                            ])
                                            ->default('draft')
                                            ->required(),
                                        Forms\Components\DatePicker::make('issue_date')
                                            ->default(now())
                                            ->required(),
                                        Forms\Components\DatePicker::make('valid_until')
                                            ->helperText('Leave empty for infinite validity')
                                            ->nullable(),
                                    ])
                                    ->columns(2),
                            ]),

                        Forms\Components\Tabs\Tab::make('Client Info')
                            ->schema([
                                Forms\Components\TextInput::make('client_company')
                                    ->required()
                                    ->maxLength(255),
                                Forms\Components\TextInput::make('client_name')
                                    ->required()
                                    ->maxLength(255),
                                Forms\Components\TextInput::make('client_email')
                                    ->email()
                                    ->required()
                                    ->maxLength(255),
                            ])
                            ->columns(1),

                        Forms\Components\Tabs\Tab::make('Financials')
                            ->schema([
                                Forms\Components\Section::make('Settings')
                                    ->schema([
                                        Forms\Components\Select::make('currency')
                                            ->options([
                                                'IDR' => 'IDR - Indonesian Rupiah',
                                                'USD' => 'USD - US Dollar',
                                                'EUR' => 'EUR - Euro',
                                            ])
                                            ->default('IDR')
                                            ->required(),
                                        Forms\Components\TextInput::make('tax_rate')
                                            ->numeric()
                                            ->default(11)
                                            ->suffix('%')
                                            ->required(),
                                    ])
                                    ->columns(2),

                                Forms\Components\Section::make('Offer 1 (Main)')
                                    ->schema([
                                        Forms\Components\TextInput::make('offer_name_1')
                                            ->maxLength(255),
                                        Forms\Components\TextInput::make('offer_1_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01),
                                        Forms\Components\TextInput::make('offer_1_original_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01)
                                            ->nullable(),
                                        Forms\Components\TextInput::make('offer_1_renewal_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01),
                                    ])
                                    ->columns(2),

                                Forms\Components\Section::make('Offer 2 (Optional)')
                                    ->schema([
                                        Forms\Components\TextInput::make('offer_name_2')
                                            ->maxLength(255)
                                            ->nullable(),
                                        Forms\Components\TextInput::make('offer_2_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01)
                                            ->nullable(),
                                        Forms\Components\TextInput::make('offer_2_original_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01)
                                            ->nullable(),
                                        Forms\Components\TextInput::make('offer_2_renewal_price')
                                            ->numeric()
                                            ->prefix(fn (Forms\Get $get) => $get('currency') ?? 'IDR')
                                            ->step(0.01)
                                            ->nullable(),
                                    ])
                                    ->columns(2),
                            ]),

                        Forms\Components\Tabs\Tab::make('Content (EN/ID)')
                            ->schema([
                                // Brief
                                Forms\Components\Section::make('Brief')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('brief')
                                                    ->schema([
                                                        Forms\Components\Textarea::make('content')
                                                            ->rows(3)
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Core Services
                                Forms\Components\Section::make('Core Services')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('core_services')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('service')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Features
                                Forms\Components\Section::make('Features')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('features')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('feature_name')
                                                            ->required(),
                                                        Forms\Components\Textarea::make('feature_description')
                                                            ->rows(2),
                                                    ])
                                                    ->columns(2)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Server
                                Forms\Components\Section::make('Server')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('server')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('item')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Assets
                                Forms\Components\Section::make('Assets')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('assets')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('asset')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Security
                                Forms\Components\Section::make('Security')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('security')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('security_item')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Support
                                Forms\Components\Section::make('Support')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('support')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('support_item')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Additional Benefits
                                Forms\Components\Section::make('Additional Benefits')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('additional_benefit')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('benefit')
                                                            ->required()
                                                            ->columnSpanFull(),
                                                    ])
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Add-ons
                                Forms\Components\Section::make('Add-ons')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('add_on')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('name')
                                                            ->required(),
                                                        Forms\Components\Textarea::make('description')
                                                            ->rows(2),
                                                        Forms\Components\TextInput::make('price')
                                                            ->numeric()
                                                            ->prefix(fn (Forms\Get $get) => $get('../../../currency') ?? 'IDR')
                                                            ->step(0.01),
                                                    ])
                                                    ->columns(3)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Payment
                                Forms\Components\Section::make('Payment Terms')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('payment')
                                                    ->schema([
                                                        Forms\Components\Textarea::make('info')
                                                            ->rows(2)
                                                            ->required(),
                                                        Forms\Components\TextInput::make('down_payment_amount')
                                                            ->numeric()
                                                            ->prefix(fn (Forms\Get $get) => $get('../../../currency') ?? 'IDR')
                                                            ->step(0.01)
                                                            ->nullable(),
                                                    ])
                                                    ->columns(2)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Terms & Conditions
                                Forms\Components\Section::make('Terms & Conditions')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('terms_condition')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('title')
                                                            ->required(),
                                                        Forms\Components\Textarea::make('description')
                                                            ->rows(2)
                                                            ->required(),
                                                    ])
                                                    ->columns(2)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Offer 1 Timeline
                                Forms\Components\Section::make('Offer 1 Project Timeline')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('offer_1_project_timeline')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('activity_name')
                                                            ->required(),
                                                        Forms\Components\TextInput::make('activity_pic')
                                                            ->required(),
                                                        Forms\Components\TextInput::make('activity_days')
                                                            ->numeric()
                                                            ->required()
                                                            ->suffix('days'),
                                                    ])
                                                    ->columns(3)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),

                                // Offer 2 Timeline
                                Forms\Components\Section::make('Offer 2 Project Timeline (Optional)')
                                    ->schema([
                                        Translate::make()
                                            ->schema([
                                                Forms\Components\Repeater::make('offer_2_project_timeline')
                                                    ->schema([
                                                        Forms\Components\TextInput::make('activity_name')
                                                            ->required(),
                                                        Forms\Components\TextInput::make('activity_pic')
                                                            ->required(),
                                                        Forms\Components\TextInput::make('activity_days')
                                                            ->numeric()
                                                            ->required()
                                                            ->suffix('days'),
                                                    ])
                                                    ->columns(3)
                                                    ->default([])
                                                    ->columnSpanFull(),
                                            ])
                                            ->locales(['en', 'id'])
                                            ->suffixLocaleLabel(),
                                    ])
                                    ->collapsible(),
                            ]),

                        Forms\Components\Tabs\Tab::make('Portfolios')
                            ->schema([
                                Forms\Components\Repeater::make('portfolios')
                                    ->schema([
                                        Forms\Components\TextInput::make('portfolio_name')
                                            ->required()
                                            ->maxLength(255),
                                        Forms\Components\TextInput::make('portfolio_image_url')
                                            ->url()
                                            ->maxLength(255),
                                        Forms\Components\TextInput::make('portfolio_link')
                                            ->url()
                                            ->maxLength(255),
                                    ])
                                    ->columns(3)
                                    ->default([])
                                    ->addable()
                                    ->reorderable()
                                    ->deletable(),
                            ]),

                        Forms\Components\Tabs\Tab::make('Internal')
                            ->schema([
                                Forms\Components\Textarea::make('notes')
                                    ->rows(5)
                                    ->columnSpanFull(),
                                Forms\Components\Section::make('Document Access')
                                    ->schema([
                                        Forms\Components\TextInput::make('access_username')
                                            ->maxLength(255)
                                            ->nullable(),
                                        Forms\Components\TextInput::make('access_password')
                                            ->password()
                                            ->maxLength(255)
                                            ->nullable()
                                            ->dehydrateStateUsing(fn (?string $state): ?string => $state ? bcrypt($state) : null)
                                            ->dehydrated(fn (?string $state): bool => filled($state)),
                                    ])
                                    ->columns(2),
                            ]),
                    ])
                    ->activeTab(1)
                    ->persistTabInQueryString(),
            ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->columns([
                Tables\Columns\TextColumn::make('document_number')
                    ->searchable()
                    ->sortable()
                    ->copyable(),
                Tables\Columns\TextColumn::make('client_company')
                    ->searchable()
                    ->sortable(),
                Tables\Columns\TextColumn::make('client_name')
                    ->searchable()
                    ->sortable(),
                Tables\Columns\TextColumn::make('offer_1_price')
                    ->money(fn ($record) => $record->currency)
                    ->sortable(),
                Tables\Columns\TextColumn::make('status')
                    ->badge()
                    ->color(fn (string $state): string => match ($state) {
                        'draft' => 'gray',
                        'published' => 'success',
                        default => 'gray',
                    }),
                Tables\Columns\TextColumn::make('issue_date')
                    ->date()
                    ->sortable(),
                Tables\Columns\TextColumn::make('invoices_count')
                    ->counts('invoices')
                    ->label('Invoices')
                    ->badge(),
                Tables\Columns\TextColumn::make('created_at')
                    ->dateTime()
                    ->sortable()
                    ->toggleable(isToggledHiddenByDefault: true),
            ])
            ->filters([
                Tables\Filters\SelectFilter::make('status')
                    ->options([
                        'draft' => 'Draft',
                        'published' => 'Published',
                    ]),
                Tables\Filters\SelectFilter::make('company_id')
                    ->relationship('company', 'brand_name')
                    ->searchable()
                    ->preload(),
                Tables\Filters\TernaryFilter::make('has_invoice')
                    ->label('Has Invoice')
                    ->placeholder('All proposals')
                    ->trueLabel('With invoices')
                    ->falseLabel('Without invoices')
                    ->queries(
                        true: fn ($query) => $query->has('invoices'),
                        false: fn ($query) => $query->doesntHave('invoices'),
                    ),
                Tables\Filters\Filter::make('issue_date')
                    ->form([
                        Forms\Components\DatePicker::make('from'),
                        Forms\Components\DatePicker::make('to'),
                    ])
                    ->query(function ($query, array $data) {
                        return $query
                            ->when($data['from'], fn ($query, $date) => $query->whereDate('issue_date', '>=', $date))
                            ->when($data['to'], fn ($query, $date) => $query->whereDate('issue_date', '<=', $date));
                    }),
                Tables\Filters\Filter::make('created_at')
                    ->form([
                        Forms\Components\DatePicker::make('from'),
                        Forms\Components\DatePicker::make('to'),
                    ])
                    ->query(function ($query, array $data) {
                        return $query
                            ->when($data['from'], fn ($query, $date) => $query->whereDate('created_at', '>=', $date))
                            ->when($data['to'], fn ($query, $date) => $query->whereDate('created_at', '<=', $date));
                    }),
                Tables\Filters\Filter::make('valid_until')
                    ->form([
                        Forms\Components\DatePicker::make('from'),
                        Forms\Components\DatePicker::make('to'),
                    ])
                    ->query(function ($query, array $data) {
                        return $query
                            ->when($data['from'], fn ($query, $date) => $query->whereDate('valid_until', '>=', $date))
                            ->when($data['to'], fn ($query, $date) => $query->whereDate('valid_until', '<=', $date));
                    }),
            ])
            ->actions([
                Tables\Actions\EditAction::make(),
                Tables\Actions\DeleteAction::make(),
            ])
            ->bulkActions([
                Tables\Actions\BulkActionGroup::make([
                    Tables\Actions\DeleteBulkAction::make(),
                ]),
            ])
            ->defaultSort('created_at', 'desc');
    }

    public static function getRelations(): array
    {
        return [];
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListProposals::class,
            'create' => Pages\CreateProposal::class,
            'edit' => Pages\EditProposal::class,
        ];
    }
}
